// Schéma de la base. Prisma sert UNIQUEMENT au schéma et aux migrations.
// Les requêtes de l'API restent en SQL brut (Bun.sql), voir DECISIONS.md D0 et D3.
// Les CHECK ne sont pas exprimables ici : ils vivent dans le SQL de la migration 'init'.

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid

  @@map("order_status")
}

enum PaymentMethod {
  card

  @@map("payment_method")
}

enum PaymentStatus {
  succeeded

  @@map("payment_status")
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName    String   @map("first_name")
  email        String   @unique
  phone        String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orders Order[]

  @@map("users")
}

model Restaurant {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dishes Dish[]
  orders Order[]

  @@map("restaurants")
}

model Dish {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  priceCents   Int      @map("price_cents")
  currency     String   @default("EUR") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]

  @@index([restaurantId])
  @@map("dishes")
}

model Order {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  status       OrderStatus @default(pending)
  totalCents   Int         @map("total_cents")
  currency     String      @default("EUR") @db.Char(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  payment    Payment?

  // Liste filtrée par utilisateur, curseur sur id (UUIDv7 = ordre chronologique).
  @@index([userId, id(sort: Desc)])
  @@index([restaurantId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  dishId         String @map("dish_id") @db.Uuid
  name           String
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish  @relation(fields: [dishId], references: [id])

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key")
  method         PaymentMethod
  status         PaymentStatus
  amountCents    Int           @map("amount_cents")
  currency       String        @db.Char(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}
